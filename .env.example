# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Домен сайта (Caddy сам получит для него HTTPS-сертификат).
DOMAIN=eureka.example.ru

# Длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eureka.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://eureka.example.ru

TIME_ZONE=Europe/Moscow
MAX_UPLOAD_MB=20

# Почта для рассылок. На хостинге Beget ничего заполнять не нужно: письма уходят через sendmail от имени
# noreply@<домен сайта>. Если письма попадают в спам, создайте ящик и укажите его SMTP (Beget: smtp.beget.com, порт 465).
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
