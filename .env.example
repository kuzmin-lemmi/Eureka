# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Домен сайта (Caddy сам получит для него HTTPS-сертификат).
DOMAIN=eureka.example.ru

# Длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eureka.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://eureka.example.ru

TIME_ZONE=Europe/Moscow
MAX_UPLOAD_MB=20
